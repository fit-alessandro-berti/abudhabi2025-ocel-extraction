{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Locally authored strict OCEL 2.0 JSON profile based on https://www.ocel-standard.org/specification/formats/json/. Not the official downloadable schema, whose URLs returned 404 during extraction.",
  "type": "object",
  "required": ["objectTypes", "eventTypes", "objects", "events"],
  "additionalProperties": false,
  "properties": {
    "objectTypes": {"type": "array", "items": {"$ref": "#/definitions/type"}},
    "eventTypes": {"type": "array", "items": {"$ref": "#/definitions/type"}},
    "objects": {"type": "array", "items": {"$ref": "#/definitions/object"}},
    "events": {"type": "array", "items": {"$ref": "#/definitions/event"}}
  },
  "definitions": {
    "type": {
      "type": "object", "required": ["name", "attributes"], "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "attributes": {"type": "array", "items": {
          "type": "object", "required": ["name", "type"], "additionalProperties": false,
          "properties": {"name": {"type": "string", "minLength": 1}, "type": {"enum": ["string", "time", "integer", "float", "boolean"]}}
        }}
      }
    },
    "relation": {
      "type": "object", "required": ["objectId", "qualifier"], "additionalProperties": false,
      "properties": {"objectId": {"type": "string", "minLength": 1}, "qualifier": {"type": "string", "minLength": 1}}
    },
    "attribute": {
      "type": "object", "required": ["name", "value"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["string", "number", "boolean"]}}
    },
    "timedAttribute": {
      "type": "object", "required": ["name", "value", "time"], "additionalProperties": false,
      "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": ["string", "number", "boolean"]}, "time": {"type": "string", "format": "date-time"}}
    },
    "object": {
      "type": "object", "required": ["id", "type", "attributes", "relationships"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "attributes": {"type": "array", "items": {"$ref": "#/definitions/timedAttribute"}},
        "relationships": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/definitions/relation"}}
      }
    },
    "event": {
      "type": "object", "required": ["id", "type", "time", "attributes", "relationships"], "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1},
        "time": {"type": "string", "format": "date-time"},
        "attributes": {"type": "array", "items": {"$ref": "#/definitions/attribute"}},
        "relationships": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/definitions/relation"}}
      }
    }
  }
}
